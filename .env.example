# ===== Обязательно =====

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID владельца (узнать: @userinfobot). Несколько — через запятую.
ADMIN_ID=

# ===== Игра =====

# Часовой пояс ежедневной премии (выплата в 00:00 и 12:00)
TZ=Europe/Moscow

# Название игры в служебных сообщениях (тексты обучения — дословно из оригинала)
GAME_NAME=Эпидемик

# Заголовок оповещений: «🦠 <заголовок> | #оповещение»
NOTIFY_TITLE=𝐄𝐩𝐢𝐝𝐞𝐦𝐢𝐜 𝐍𝐨𝐭𝐢𝐟𝐲

# ===== Ссылки (необязательно, пустые не показываются) =====

GUIDE_URL=
CHAT_URL=
CHANNEL_URL=
RULES_URL=

# Контакты поддержки в меню /start, например: @support_one, @support_two
SUPPORT=

# ===== Служебное =====

LOG_LEVEL=INFO
